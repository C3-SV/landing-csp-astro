---
type Sponsor = {
    name: string;
    logo?: string;
    className?: string;
    containerClass?: string;
};

// Each row deliberately has five positions to preserve the approved layout
// while the remaining logo files are received.
const sponsorRows: { size: "featured" | "medium" | "lower"; sponsors: Sponsor[] }[] = [
    {
        size: "featured",
        sponsors: [
            { name: "RSM", logo: "/sponsors/rsm.webp" },
            { name: "TechyWe", logo: "/sponsors/techywe.webp" },
            { name: "Boxful", logo: "/sponsors/boxful.webp" },
            { name: "Applaudo", logo: "/sponsors/applaudo.webp" },
            {
                name: "Datalysis",
                logo: "/sponsors/datalysis.jpeg",
                className: "sponsor-logo--datalysis",
            },
        ],
    },
    {
        size: "medium",
        sponsors: [
            {
                name: "Simplexo",
                logo: "/sponsors/simplexo.svg",
                className: "sponsor-logo--simplexo",
            },
            { name: "FUSADES", logo: "/sponsors/fusades.webp" },
            { name: "Search You", logo: "/sponsors/search-you.png" },
            { name: "Enblueprint", logo: "/sponsors/enblueprint.webp" },
            { name: "RAVN", logo: "/sponsors/ravn.webp" },
        ],
    },
    {
        size: "lower",
        sponsors: [
            {
                name: "omegaUp",
                logo: "/sponsors/omegaup.png",
                className: "sponsor-logo--omegaup",
            },
            { name: "OSI", logo: "/sponsors/logo_osi.webp" },
            {
                name: "Crecer",
                logo: "/sponsors/afp-crecer.png",
                className: "sponsor-logo--crecer",
            },
            {
                name: "Creativa Studios",
                logo: "/sponsors/creativa-studios.jpg",
                className: "sponsor-logo--creativa",
            },
            {
                name: "Campus Life",
                logo: "/sponsors/campus-life.png",
                containerClass: "sponsor--campus",
            },
        ],
    },
];
---

<section id="sponsors" class="w-full py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
        <div class="mb-10 md:mb-12">
            <h2
                class="font-display text-4xl font-bold text-csp-primary md:text-5xl"
            >
                Nuestros Patrocinadores y Aliados
            </h2>
        </div>

        <div class="space-y-3.5 md:space-y-4">
            {
                sponsorRows.map(({ size, sponsors }, index) => (
                    <div
                        class:list={[
                            "grid grid-cols-2 items-center gap-x-3 gap-y-2 sm:grid-cols-5 sm:gap-x-5",
                            index === 2 && "mt-2 md:mt-3",
                        ]}
                    >
                        {sponsors.map((sponsor) => (
                            <div
                                class:list={[
                                    "flex w-full items-center justify-center",
                                    size === "featured"
                                        ? "h-20 sm:h-24 md:h-32"
                                        : size === "medium"
                                          ? "h-14 sm:h-[4.5rem] md:h-20"
                                          : "h-12 sm:h-14 md:h-16",
                                    sponsor.containerClass,
                                ]}
                            >
                                {sponsor.logo ? (
                                    <img
                                        src={sponsor.logo}
                                        alt={`Logo de ${sponsor.name}`}
                                        class:list={[
                                            "max-w-full object-contain",
                                            size === "featured"
                                                ? "max-h-16 sm:max-h-20 md:max-h-24"
                                                : size === "medium"
                                                  ? "max-h-12 sm:max-h-[3.625rem] md:max-h-[4.25rem]"
                                                  : "max-h-8 sm:max-h-10 md:max-h-[2.75rem]",
                                            sponsor.className,
                                        ]}
                                        loading="lazy"
                                    />
                                ) : (
                                    <span class="sr-only">Espacio reservado para {sponsor.name}</span>
                                )}
                            </div>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* Convert the supplied black-matte JPG into a dark mark on the original
       light page background, without exposing a rectangular image backdrop. */
    .sponsor-logo--datalysis {
        filter: invert(1) grayscale(1);
        mix-blend-mode: multiply;
    }

    .sponsor-logo--creativa {
        mix-blend-mode: multiply;
        transform: scale(2.9);
    }

    /* This file has a very generous Illustrator canvas around the mark. */
    .sponsor-logo--simplexo {
        transform: scale(2.5);
    }

    .sponsor-logo--omegaup {
        max-height: 2rem;
    }

    .sponsor-logo--crecer {
        max-height: 2.2rem;
    }

    .sponsor--campus {
        border-radius: 0.5rem;
        background: #3b2d8e;
        padding: 0.375rem 0.625rem;
    }
</style>
