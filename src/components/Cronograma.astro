---
export type CronogramaIcon =
    | "clipboard"
    | "checklist"
    | "megaphone"
    | "code"
    | "utensils"
    | "presentation"
    | "users"
    | "trophy";

export type CronogramaItem = {
    timeStart: string;
    timeEnd: string;
    title: string;
    icon: CronogramaIcon;
};

type Props = {
    items: CronogramaItem[];
};

const { items } = Astro.props as Props;

const ICON_PATHS: Record<CronogramaIcon, string> = {
    clipboard:
        '<path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1Z"></path><rect x="5" y="6" width="14" height="16" rx="2"></rect><path d="m9 13 2 2 4-4"></path>',
    checklist:
        '<rect x="5" y="4" width="14" height="17" rx="2"></rect><path d="M9 4V2h6v2"></path><path d="m8 10 1.5 1.5L12 9"></path><path d="M14 10h2"></path><path d="m8 15 1.5 1.5L12 14"></path><path d="M14 15h2"></path>',
    megaphone:
        '<path d="m3 11 18-5v12L3 13v-2Z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>',
    code: '<polyline points="8 6 3 12 8 18"></polyline><polyline points="16 6 21 12 16 18"></polyline>',
    utensils:
        '<line x1="5" y1="2" x2="5" y2="9"></line><line x1="8" y1="2" x2="8" y2="9"></line><line x1="11" y1="2" x2="11" y2="9"></line><line x1="8" y1="9" x2="8" y2="22"></line><path d="M15 2 L19 2 L15 12 Z"></path><line x1="15" y1="12" x2="15" y2="22"></line>',
    presentation:
        '<path d="M2 4h20"></path><path d="M4 4v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V4"></path><path d="m9 20 3-4 3 4"></path>',
    users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
    trophy:
        '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M6 4h12v5a6 6 0 0 1-12 0V4Z"></path><path d="M10 15v3"></path><path d="M14 15v3"></path><path d="M8 22h8"></path><path d="M9 22v-3.5"></path><path d="M15 22v-3.5"></path>',
};
---

<ol class="relative">
    <div
        class="absolute left-6 top-0 bottom-0 w-0.5 bg-csp-primary md:left-7"
        aria-hidden="true"
    >
    </div>
    {
        items.map(({ timeStart, timeEnd, title, icon }) => (
            <li class="relative flex items-center gap-[1rem] pb-5 last:pb-0 md:gap-[1.25rem] md:pb-6">
                <span class="relative z-10 flex h-[3rem] w-[3rem] shrink-0 items-center justify-center rounded-full bg-[#EBEAF3] text-csp-primary ring-4 ring-[#f4f5f8] md:h-[3.5rem] md:w-[3.5rem]">
                    <svg
                        class="h-6 w-6 md:h-7 md:w-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={ICON_PATHS[icon]}
                    />
                </span>
                <div class="min-w-0 flex-1 rounded-2xl border border-gray-100 bg-white px-4 py-4 shadow-sm md:px-5">
                    <span class="text-[0.7rem] font-bold uppercase tracking-widest text-[#0BAA9F]">
                        {timeStart} – {timeEnd}
                    </span>
                    <p class="mt-1 font-display text-[1rem] leading-[1.5rem] font-semibold text-csp-black md:text-[1.125rem] md:leading-[1.75rem]">
                        {title}
                    </p>
                </div>
            </li>
        ))
    }
</ol>
